{
  "name": "hydrogen-water-bottle-store",
  "version": "1.0.0",
  "description": "Ultra-premium Hydrogen Water Bottle e-commerce - Angular 19 + Signals",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0 --port 4200",
