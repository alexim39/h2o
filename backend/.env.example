# H2Os Ultra H₂ — Backend Environment
# Copy to .env and fill with real credentials on cPanel (above public_html)

APP_ENV=production
APP_DEBUG=false
APP_URL=https://hydrogenwaterbottles.store
APP_FRONTEND_URL=https://hydrogenwaterbottles.store

# Database (MySQL 8.0+)
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=hydrogen_store
DB_USERNAME=hydrogen_user
DB_PASSWORD=change_me_strong_password
DB_CHARSET=utf8mb4

# Paystack — swap test ↔ live in .env
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# DeepSeek AI — H2Os Assistant Doctor (replace mock before deployment)
DEEPSEEK_API_KEY=sk-deepseek-mock-REPLACE_WITH_REAL_KEY
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-chat

# CORS — comma-separated allowed origins (frontend + local dev)
CORS_ALLOWED_ORIGINS=https://hydrogenwaterbottles.store,https://www.hydrogenwaterbottles.store,http://localhost:4200

# WhatsApp — escalation for AI
WHATSAPP_NUMBER=2348080386208

# MGT Admin (change before production)
MGT_USER=h2os
MGT_PASS=UltraH2@2025

# Optional: fallback to mock data if DB unavailable
DB_MOCK_FALLBACK=true
